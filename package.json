{
  "name": "medikiosk-monorepo",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:packages": "npm --prefix packages/shared-types run build",
    "build:backend": "npm --prefix apps/backend run build",
    "build:patient-kiosk": "npm --prefix apps/patient-kiosk run build",
    "build:doctor-portal": "npm --prefix apps/doctor-portal run build",
    "build:hospital-portal": "npm --prefix apps/hospital-portal run build",
    "lint": "oxlint .",
    "preview": "vite preview"
  },
  "dependencies": {
    "lucide-react": "^1.16.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.8.2"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.0"
  }
}
